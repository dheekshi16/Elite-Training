import java.util.*;
class Node{
    Node prev;
    int data;
    Node next;
    Node head=null,tail=null;
    
    
    Node(Node p,int d ,Node n){
        this.prev=p;
        this.data=d;
        this.next=n;
    }
    
    Node(){
        
    }
    
    void insertnode(){
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter no of node:");
        int num=sc.nextInt();
        for(int i=0;i<num;i++){
            int val=sc.nextInt();
            Node obj=new Node(null,val,null);
            
            if(head==null){
                head=obj;
                tail=obj;
            }
          
            else{
              prev.next=obj;
              prev=obj;
                
            }            
        }
    }
    
    void displaynode(){
        Node temp=head;
        while(temp!=null){
            System.out.println(temp.data);
            temp=temp.next;
        }
    }
    
    void displayrevnode(){
        Node temp=tail;
        while(temp!=null){
            System.out.println(temp.data);
            temp=temp.prev;
        }
    }
    
    void insertANode(){
     
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter no of pos:");
        int pos=sc.nextInt();
        System.out.println("Enter val:");
        int v=sc.nextInt();
        Node newnode=new Node(null,v,null);
        
        if(pos==1){
            newnode.next=head;
            head.prev=newnode;
            head = newnode;
        }
        
        else {
            Node temp=head;
            for(int i=0;i<pos-2;i++){
              temp=temp.next;
          }
          
          if(temp.next==null){
              
            temp.next=newnode;
            newnode.prev=temp;
            tail=newnode;
         }
         
         else{
            newnode.prev=temp;
            newnode.next=temp.next;
            temp.next.prev=newnode;
            temp.next=newnode;
         }
            
        }
          
  
    }
    void deleteANode(){
        Scanner sc=new Scanner(System.in);
        System.out.println("enter a pos:");
        int pos=sc.nextInt();
        Node temp=head;
        
        if(pos==1){
            head=temp.next;
        }
        
        else{
            for(int i=0;i<pos-2;i++){
              temp=temp.next;
          }
           
        }
        
        if(temp.next.next==null){
            tail=temp;
        }
        temp.next=temp.next.next;
     }
    
}
public class Main
{
	public static void main(String[] args) {
	Scanner sc=new Scanner(System.in);
		Node node=new Node();
		while(true){
		    System.out.println("1.insert \n2.display \n3.displayrev \n4.insertANode \n5.deleteANode");
		    int ch=sc.nextInt();
		    switch(ch){
		        case 1:{
		            node.insertnode();
		            break;
		        }
		        case 2:{
		            node.displaynode();
		            break;
		        }
		        case 3:{
		            node.displayrevnode();
		            break;
		        }
		        case 4:{
		            node.insertANode();
		            break;
		        }
		        case 5:{
		            node.deleteANode();
		            break;
		        }
		    }
		}
		
	}
}
